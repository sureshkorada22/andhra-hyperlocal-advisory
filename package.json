{
  "name": "andhra-pradesh-hyperlocal-advisory",
  "version": "1.0.0",
  "private": true,
  "description": "SIH 2026 — Andhra Pradesh Hyper-Local Business Advisory Engine",
  "scripts": {
    "dev": "node run.js",
    "start": "node run.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && PYTHONPATH=. ./venv/bin/python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm --prefix frontend run build",
    "test": "cd backend && PYTHONPATH=. ./venv/bin/python3 -m pytest"
  }
}
